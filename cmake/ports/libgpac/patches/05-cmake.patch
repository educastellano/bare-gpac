diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,95 @@
+cmake_minimum_required(VERSION 3.31)
+
+project(gpac C)
+
+configure_file(
+  ${CMAKE_CURRENT_SOURCE_DIR}/config.h.in
+  ${CMAKE_CURRENT_BINARY_DIR}/include/config.h
+)
+
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/include/gpac/revision.h" "#define GPAC_GIT_REVISION \"${GPAC_GIT_REVISION}\"\n")
+
+add_library(gpac STATIC)
+
+set_target_properties(
+  gpac
+  PROPERTIES
+    POSITION_INDEPENDENT_CODE ON
+    C_VISIBILITY_PRESET hidden
+)
+
+target_include_directories(
+  gpac
+  PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}/include
+    ${CMAKE_CURRENT_BINARY_DIR}/include
+)
+
+target_compile_definitions(
+  gpac
+  PUBLIC
+    GPAC_HAVE_CONFIG_H
+    GPAC_STATIC_LIB
+  PRIVATE
+    GF_EXPORT=
+    GPAC_DISABLE_REMOTERY
+)
+
+target_sources(
+  gpac
+  PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/avc_ext.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/box_code_3gpp.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/box_code_apple.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/box_code_base.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/box_code_drm.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/box_code_meta.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/box_funcs.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/data_map.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/drm_sample.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/isom_intern.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/isom_read.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/isom_store.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/isom_write.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/media.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/media_odf.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/meta.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/sample_descs.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/stbl_read.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/stbl_write.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/track.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/tx3g.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/isomedia/iff.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/odf/desc_private.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/odf/descriptors.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/odf/odf_code.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/odf/odf_codec.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/odf/odf_command.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/odf/slc.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/os_divers.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/os_file.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/list.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/bitstream.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/constants.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/error.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/alloc.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/url.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/configfile.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/gzio.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/os_thread.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/os_config_init.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/utf.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/token.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/utils/base_encoding.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/src/media_tools/av_parsers.c
+)
+
+if(UNIX)
+  target_compile_options(gpac PRIVATE -ffunction-sections -fdata-sections -Wno-pointer-sign)
+  target_link_libraries(gpac PRIVATE m ${CMAKE_DL_LIBS})
+endif()
+
+install(TARGETS gpac ARCHIVE DESTINATION lib)
+install(DIRECTORY include/gpac DESTINATION include)
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/include/config.h" DESTINATION include)
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/include/gpac/revision.h" DESTINATION include/gpac)
